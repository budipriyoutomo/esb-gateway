APP_NAME="ERP Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Application timestamps are stored in UTC. ESB responses carry Asia/Jakarta
# wall-clock times with no offset and are converted explicitly on ingest --
# see docs/05-api-integration.md and docs/07-database-design.md.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (ADR-004). Requires the pdo_pgsql PHP extension.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erp_gateway
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis (ADR-005) backs the queue, the cache, and the ESB token lock (ADR-009).
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

# Use "phpredis" where the PHP extension is available; "predis" is the pure-PHP
# fallback and is what the predis/predis Composer package provides.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# ERP ESB integration
# --------------------------------------------------------------------------
# Placeholders only -- never commit real credentials (docs/10-security.md).
# These keys are read by config/esb.php, which arrives in Phase 3 (TODO.md).
#
# Which environment and credentials this project is entitled to is still
# unconfirmed with the ESB team -- see "What is still TBD" in
# docs/05-api-integration.md.

# Environment selector: production | staging | staging_int
ESB_ENV=staging_int

# Authentication mechanism: static_token | login
#
# "static_token" is preferred where available: the ESB permits only one active
# session per credential, so the login flow requires a shared, locked token
# cache to avoid concurrent logins invalidating each other (ADR-009).
ESB_AUTH_MECHANISM=static_token

# Used when ESB_AUTH_MECHANISM=static_token
ESB_STATIC_TOKEN=

# Used when ESB_AUTH_MECHANISM=login. Must be dedicated integration
# credentials, never a person's ESB Core account -- a human signing in with the
# same credentials would invalidate the gateway's session.
ESB_USERNAME=
ESB_PASSWORD=

# Timeouts in seconds. The vendor does not document server-side budgets; these
# are our own limits and are marked TBD in docs/05-api-integration.md.
ESB_CONNECT_TIMEOUT=5
ESB_TIMEOUT=30

# Optional per-family base URL overrides. Defaults for each environment live in
# config/esb.php; set these only to point a family somewhere else. Base URLs are
# not uniform across endpoint groups (ADR-010).
# ESB_BASE_URL_CORE=
# ESB_BASE_URL_VOUCHER=
# ESB_BASE_URL_FNB_BACKEND=
# ESB_BASE_URL_POS=
