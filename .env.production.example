# Production .env template for the Docker deployment (docker-compose.yml).
# Copy to .env on the VPS and fill in every <...>. Never commit the real file.
#
# This file is read twice: by Compose for ${...} in docker-compose.yml, and as
# every container's environment. A literal "$" in a value must be written "$$".

# --------------------------------------------------------------------------
# Compose
# --------------------------------------------------------------------------
# Network of the existing maharasa-postgres container.
POSTGRES_NETWORK=posgresql_default
# Network of the Nginx Proxy Manager container.
PROXY_NETWORK=<npm-network-name>
# Tag for the built images; set per release to keep the previous one for rollback.
IMAGE_TAG=latest
# The app container runs app:check-production-readiness + migrate --force on start.
# Set to false only to start without them (e.g. to inspect a failing release).
RUN_MIGRATIONS=true

# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
APP_NAME="ERP Gateway"
APP_ENV=production
# Generate once: docker compose run --rm --no-deps app php artisan key:generate --show
# Back it up SEPARATELY from the database: it encrypts the stored ESB
# credentials (ADR-018) -- losing it loses them.
APP_KEY=<base64:...>
APP_DEBUG=false
APP_URL=https://esbgate.maharasa.id
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# stderr so `docker compose logs` shows application logs.
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --------------------------------------------------------------------------
# PostgreSQL -- existing container, reached over POSTGRES_NETWORK
# --------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=maharasa-postgres
DB_PORT=5432
DB_DATABASE=erp_gateway
DB_USERNAME=erp_gateway
DB_PASSWORD=<db-password>

# --------------------------------------------------------------------------
# Session -- checked by app:check-production-readiness
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --------------------------------------------------------------------------
# Redis -- the `redis` service in docker-compose.yml
# --------------------------------------------------------------------------
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
# Also used by Compose to start the redis service. Avoid "$" (see top).
REDIS_PASSWORD=<redis-password>

# Must exceed the longest job timeout (document template import: 1800s), or a
# long import is handed to a second worker while the first is still running.
REDIS_QUEUE_RETRY_AFTER=1860

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@maharasa.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# ERP ESB -- production
# --------------------------------------------------------------------------
ESB_ENV=production
ESB_AUTH_MECHANISM=static_token
ESB_STATIC_TOKEN=<esb-token>
# When ESB_AUTH_MECHANISM=login -- dedicated integration credentials only.
ESB_USERNAME=
ESB_PASSWORD=

ESB_CONNECT_TIMEOUT=5
ESB_TIMEOUT=30
ESB_INTEGRATION_LOG_RETENTION_DAYS=90
